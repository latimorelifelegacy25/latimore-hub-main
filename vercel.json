{
  "framework": "nextjs",
  "buildCommand": "npm run build:safe",
  "env": {
    "ENABLE_OPERATIONAL_ANALYTICS_FALLBACK": "true"
  },
  "crons": [
    {
      "path": "/api/cron/google-appointments-sync",
      "schedule": "5 13 * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 13 * * *"
    }
  ]
}
