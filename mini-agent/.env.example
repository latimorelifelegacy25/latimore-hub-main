# Copy to .env (or export these in your shell)
OPENAI_API_KEY=sk-your-key-here
MODEL=gpt-4o
PROVIDER=openai   # which backend in providers.py (openai for now)

# Uncomment to approve every shell command before it runs (recommended at first):
# CONFIRM_SHELL=1

# --- Telegram bot (only needed for bot.py) ---
# TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather
# TELEGRAM_ALLOWED_IDS=123456789   # your numeric Telegram user id (@userinfobot)
# BOT_REQUIRE_APPROVAL=1           # 1 = Approve/Deny buttons before each shell command
# SEND_SHOTS=1                     # 1 = send browser screenshots to the chat
